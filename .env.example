# Template Environment Supabase untuk DSA Incentive Tracker
# Salin file ini menjadi `.env` lalu isi dengan kredensial project Supabase Anda:
# cp .env.example .env
# File `.env` sudah masuk ke .gitignore sehingga TIDAK AKAN PERNAH ter-commit ke Git.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Konfigurasi Google Form Aktivitas Harian Visit (opsional, diisi lewat --dart-define)
VISIT_FORM_URL=
VISIT_FORM_CUSTOMER_ENTRY=
VISIT_FORM_CATEGORY_ENTRY=
